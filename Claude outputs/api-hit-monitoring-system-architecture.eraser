title API Hit Monitoring — System Architecture

direction right
colorMode pastel
styleMode shadow

"Client Backend" [icon: code, color: gray]

"API Service (Producer)" [icon: nodejs, color: green] {
  "Express API" [icon: nodejs, label: "Express API"]
}

"Message Broker" [color: orange] {
  Queue [icon: rabbitmq, label: "api_hits queue"]
  DLQ [icon: rabbitmq, label: "api_hits.dlq", color: red]
}

"Consumer Worker" [icon: nodejs, color: yellow, label: "Consumer (planned — not built yet)"]

Datastores [color: blue] {
  Mongo [icon: mongodb, label: "MongoDB — accounts, keys, raw hits (30d TTL)"]
  Postgres [icon: postgresql, label: "PostgreSQL — endpoint_metrics rollups"]
}

"Client Backend" > "Express API": "HTTP request (tracked call)"
"Express API" > Queue: "publish hit event"
Queue --> DLQ: "failed / rejected message"
Queue > "Consumer Worker": "consume"
"Consumer Worker" > Mongo: "insert raw hit"
"Consumer Worker" > Postgres: "upsert time-bucket rollup"
"Express API" > Mongo: "auth / accounts / API keys"

legend [position: bottom-left] {
  [connection: >, label: "synchronous call"]
  [connection: -->, label: "async / dead-letter path"]
  [color: red, label: "failure path"]
  [color: yellow, label: "not built yet"]
}
